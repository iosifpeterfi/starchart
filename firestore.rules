rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{familyId} {
      // Only members or invited pending members can read
      allow read: if request.auth != null
        && (
          request.auth.uid in resource.data.members
          || (request.auth.token.email != null
              && request.auth.token.email.lower() in resource.data.pendingMembers)
        );

      // Anyone authenticated can create a new family
      allow create: if request.auth != null
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members;

      // Members can update, OR a pending member can join (add themselves)
      allow update: if request.auth != null
        && (
          request.auth.uid in resource.data.members
          || (request.auth.token.email != null
              && request.auth.token.email.lower() in resource.data.pendingMembers)
        );

      // Only members can delete
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
